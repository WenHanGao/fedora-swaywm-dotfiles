# Sway configuration entry point.
# Read `man 5 sway` for a complete reference.

# Base fragments load before Fedora's layered defaults, preserving the original
# configuration precedence.
include ~/.config/sway/conf.d/10-variables.conf
include ~/.config/sway/conf.d/20-outputs.conf
include ~/.config/sway/conf.d/30-idle.conf
include ~/.config/sway/conf.d/40-inputs.conf
include ~/.config/sway/conf.d/50-keybindings.conf
include ~/.config/sway/conf.d/60-gestures.conf

# Load distribution defaults while replacing Fedora's bar and Swaylock idle
# fragments with the local Quickshell and Gtklock policies. Other local
# fragments are explicit so every command and binding is evaluated once.
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/conf.d/90-bar.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/conf.d/90-swayidle.conf")'

# Personal settings intentionally override the layered defaults above.
include ~/.config/sway/conf.d/90-overrides.conf
